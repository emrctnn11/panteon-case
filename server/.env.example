# Copy to .env for local development. PORT/NODE_ENV are optional (defaults shown).
PORT=3000
NODE_ENV=development

# Required, no default (no secrets in code — CLAUDE.md).
DATABASE_URL=postgres://user:password@localhost:5432/leaderboard
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/leaderboard

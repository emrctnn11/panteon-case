# Copy to .env for local development. PORT/NODE_ENV are optional (defaults shown).
PORT=3000
NODE_ENV=development

# Required, no default (no secrets in code — CLAUDE.md).
DATABASE_URL=postgres://user:password@localhost:5432/leaderboard
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/leaderboard
# HS256 signing secret for player JWTs (min 32 chars). Tokens are minted out-of-band; the
# API only verifies them and trusts the `sub` claim as the player id.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret

# Minor units of prize pool credited per unit of raw earnings (README §3.1's "2%" convention).
SCORE_POOL_MULTIPLIER=2

# Shared secret for the EventBridge-triggered POST /internal/payout endpoint (min 32 chars).
# Set as a static header (x-internal-secret) on the EventBridge Scheduler HTTP target.
INTERNAL_PAYOUT_SECRET=change-me-to-a-random-32-plus-character-secret

# Reward curve exponent (README §3.5 — harmonic tail, alpha = 1.0 chosen for ranks 4-100).
PAYOUT_CURVE_ALPHA=1
